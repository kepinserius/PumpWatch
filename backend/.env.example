# PumpWatch Configuration

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pumpwatch

# Logging
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Admin (untuk protect admin endpoints)
ADMIN_API_KEY=your_admin_api_key_here

# Telegram (untuk alerts)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Data Providers
DEXSCREENER_API_URL=https://api.dexscreener.com/latest
GECKO_TERMINAL_API_URL=https://api.geckoterminal.com/api/v2

# Request Handling
REQUEST_TIMEOUT=30
RATE_LIMIT_DELAY=1.0

# Risk & Scoring
MIN_LIQUIDITY_USD=5000.0
MOMENTUM_THRESHOLD=65
ALERT_COOLDOWN_MINUTES=60

# Background Workers
SCAN_INTERVAL_MINUTES=5
SCAN_ON_STARTUP=true

# Post-MVP Features
ARCHIVE_INTERVAL_MINUTES=60
ARCHIVE_RETENTION_DAYS=90
ANALYTICS_AGGREGATION_INTERVAL_MINUTES=60
BACKTEST_DEFAULT_FEE_PERCENT=0.01
BACKTEST_DEFAULT_SLIPPAGE_PERCENT=0.005
